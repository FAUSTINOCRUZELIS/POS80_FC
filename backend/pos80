#!/usr/bin/python3
"""CUPS backend para POS80.

Recibe el ESC/POS que genera el filtro rastertozj y lo envía al puerto 9100.
La diferencia con el backend `socket` es que mantiene la conexión abierta un
par de segundos después de enviar: el servidor de impresión lwIP de esta
impresora descarta el final del trabajo (incluido el comando de corte) si el
socket se cierra inmediatamente.
"""

import os
import socket
import sys
import time
import urllib.parse


def main() -> int:
    # Sin argumentos, CUPS pide descubrimiento de dispositivos. No hay nada que
    # anunciar.
    if len(sys.argv) == 1:
        return 0

    if len(sys.argv) < 6:
        print(
            "ERROR: uso: pos80 job-id user title copies options [archivo]",
            file=sys.stderr,
        )
        return 1

    uri = os.environ.get("DEVICE_URI", "pos80://192.168.1.107:9100")
    parsed = urllib.parse.urlparse(uri)
    host = parsed.hostname or "192.168.1.107"
    port = parsed.port or 9100

    if len(sys.argv) >= 7:
        try:
            with open(sys.argv[6], "rb") as job_file:
                data = job_file.read()
        except OSError as exc:
            print(f"ERROR: no se pudo leer el trabajo: {exc}", file=sys.stderr)
            return 1
    else:
        data = sys.stdin.buffer.read()

    if not data:
        print("INFO: trabajo vacío", file=sys.stderr)
        return 0

    try:
        sock = socket.create_connection((host, port), timeout=10)
    except OSError as exc:
        print(f"ERROR: no se pudo conectar a {host}:{port}: {exc}", file=sys.stderr)
        return 1

    try:
        sock.sendall(data)
        try:
            sock.shutdown(socket.SHUT_WR)
        except OSError:
            pass
        # Espera a que el servidor de impresión consuma el buffer y ejecute el
        # corte antes de cerrar la conexión.
        time.sleep(2.0)
    finally:
        sock.close()

    print(f"INFO: {len(data)} bytes enviados a {host}:{port}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
